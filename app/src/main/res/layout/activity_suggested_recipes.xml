<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F7F9F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suggested Recipes"
        android:textColor="#245C42"
        android:textSize="28sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipes you can make with your current pantry ingredients."
        android:textColor="#555555"
        android:textSize="15sp"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/txtNoRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No recipes match your current pantry quantities. Try adding ingredients or increasing their quantities."
        android:textColor="#555555"
        android:textSize="16sp"
        android:padding="12dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listSuggestedRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DDDDDD"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btnBackToPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Pantry" />

</LinearLayout>